# Copy to .env (docker stack deploy --env-file needs `docker compose config`
# style loading via `env $(cat .env | xargs) docker stack deploy ...`, or
# just `source .env` before running scripts/deploy_stack.sh).

# Image registry the manager pushes worker/coordinator images to and every
# worker node pulls from. A local insecure registry on the manager is the
# easiest option for a closed lab cluster -- see scripts/setup_manager.sh.
REGISTRY=10.0.0.10:5000

STACK_NAME=mn-data-prepare

# Shared storage (NFS export on the manager, mounted identically on every
# node -- see docker/nfs/*.sh)
NFS_SERVER=10.0.0.10
NFS_DATA_EXPORT=/srv/genai/data
NFS_PREPARE_EXPORT=/srv/genai/data_prepare
MOUNT_DATA=/mnt/genai/data
MOUNT_PREPARE=/mnt/genai/data_prepare

# Ollama model
OLLAMA_BASE_MODEL=muse-glimmer:30b
OLLAMA_INSTRUCTED_TAG=muse-glimmer-mn

# Only needed for pipeline/push_to_hub.py
HF_TOKEN=
